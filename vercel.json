{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sfo1"
  ],
  "schedules": {
    "mantenimiento-diario": {
      "path": "/api/cron/diario",
      "schedule": "0 11 * * *",
      "requestMethod": "GET",
      "jitter": 15
    },
    "recuperacion-cobros": {
      "path": "/api/cron/cobros",
      "schedule": "*/15 * * * *",
      "requestMethod": "GET",
      "jitter": 15
    }
  }
}
