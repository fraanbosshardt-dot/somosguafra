{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/auditoria-integral-20261115": false,
      "fix/alertas-operativas": false,
      "fix/diagnostico-conciliacion": false,
      "fix/consulta-pagos-proveedor": false
    }
  },
  "regions": [
    "sfo1"
  ],
  "schedules": {
    "mantenimiento-diario": {
      "path": "/api/cron/diario",
      "schedule": "0 11 * * *",
      "requestMethod": "GET",
      "jitter": 15
    },
    "recuperacion-cobros": {
      "path": "/api/cron/cobros",
      "schedule": "*/15 * * * *",
      "requestMethod": "GET",
      "jitter": 15
    }
  }
}
